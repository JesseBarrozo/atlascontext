{
  "name": "@atlascontext/mcp",
  "version": "0.2.0",
  "description": "Deterministic, local project cartography exposed through MCP.",
  "type": "module",
  "bin": {
    "atlas-mcp": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/atlas-core.mjs",
    "./server": "./src/server.mjs"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/atlas-core.mjs && node --check src/server.mjs",
    "generate": "node src/atlas-cli.mjs generate .",
    "atlas:check": "node src/atlas-cli.mjs check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "license": "MIT"
}
